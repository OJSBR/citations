msgid "plugins.generic.citations.title"
msgstr "Scopus/Crossref-plug-in"

msgid "plugins.generic.citations.desc"
msgstr "Deze plug-in toont het totale aantal citaties en een lijst met “geciteerd door”-artikelen uit Scopus en/of Crossref."

msgid "plugins.generic.citations.provider"
msgstr "Aanbieder"

msgid "plugins.generic.citations.provider.desc"
msgstr "Kies tussen Crossref, Scopus of beide."

msgid "plugins.generic.citations.options.all"
msgstr "Scopus en Crossref"

msgid "plugins.generic.citations.options.scopus"
msgstr "Scopus"

msgid "plugins.generic.citations.options.crossref"
msgstr "Crossref"

msgid "plugins.generic.citations.api.desc"
msgstr "De API-gegevens worden in de volgende velden gevraagd. Ze worden opgeslagen maar om veiligheidsredenen niet opnieuw getoond. U hoeft ze niet opnieuw in te voeren; de reeds opgeslagen gegevens worden gebruikt. Zijn er gegevens opgeslagen, dan hebben de betreffende velden een blauwe rand."

msgid "plugins.generic.citations.scopus"
msgstr "Scopus"

msgid "plugins.generic.citations.scopus.desc"
msgstr "Om citatiestatistieken uit Scopus op te halen hebt u een API-sleutel nodig. Hebt u er nog geen, dan kunt u er <a href=\"https://dev.elsevier.com/sc_apis.html\" target=\"_blank\">hier</a> gratis een aanvragen"

msgid "plugins.generic.citations.scopus.key"
msgstr "Voer hier de Scopus API-sleutel in."

msgid "plugins.generic.citations.crossref"
msgstr "CrossRef"

msgid "plugins.generic.citations.crossref.desc"
msgstr "Voor toegang tot Crossref moet u <a href=\"https://www.crossref.org/membership/\" target=\"_blank\">lid</a> zijn van Crossref. Daaraan zijn <a href=\"https://www.crossref.org/fees/\" target=\"_blank\">kosten</a> verbonden.<br />Bent u lid van Crossref, voer dan hier uw gegevens in.<br /><strong>De Cited-by-dienst staat standaard aan voor alle Crossref-leden en -prefixen.</strong>"

msgid "plugins.generic.citations.crossref.name"
msgstr "Voer hier de Crossref-gebruikersnaam in."

msgid "plugins.generic.citations.crossref.pwd"
msgstr "Voer hier het Crossref-wachtwoord in."

msgid "plugins.generic.citations.show.total"
msgstr "Totaal aantal citaties"

msgid "plugins.generic.citations.show.total.desc"
msgstr "Het totale aantal citaties kan met deze optie in- of uitgeschakeld worden."

msgid "plugins.generic.citations.show.total.check"
msgstr "Totaal aantal citaties inschakelen"

msgid "plugins.generic.citations.show.list"
msgstr "lijst met “geciteerd door”-artikelen"

msgid "plugins.generic.citations.show.list.desc"
msgstr "De lijst “geciteerd door” kan met deze optie in- of uitgeschakeld worden"

msgid "plugins.generic.citations.show.list.check"
msgstr "De lijst “geciteerd door” inschakelen"

msgid "plugins.generic.citations.max.height"
msgstr "Blokhoogte"

msgid "plugins.generic.citations.max.height.desc"
msgstr "Voer hier de maximale hoogte van het blok in. Laat u het veld leeg of vult u 0 in, dan wordt de hoogte niet beperkt."

msgid "plugins.generic.citations.show.google"
msgstr "Google Scholar"

msgid "plugins.generic.citations.show.google.desc"
msgstr "De link naar het zoeken in Google Scholar kan met deze optie in- of uitgeschakeld worden."

msgid "plugins.generic.citations.show.google.check"
msgstr "Google Scholar inschakelen"

msgid "plugins.generic.citations.show.pmc"
msgstr "Europe PMC"

msgid "plugins.generic.citations.show.pmc.desc"
msgstr "De link naar het zoeken in Europe PMC kan met deze optie in- of uitgeschakeld worden."

msgid "plugins.generic.citations.show.pmc.check"
msgstr "Europe PMC inschakelen"
